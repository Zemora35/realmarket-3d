# RealMarket — üretim ortam değişkenleri (sunucuda release/.env olarak kopyalayın; git'e eklemeyin).
# Tüm gizli değerleri uzun ve rastgele üretin:  openssl rand -hex 32

# Alan adı (DNS A/AAAA kaydı sunucuyu göstermeli) ve Let's Encrypt bildirim e-postası
SITE_DOMAIN=market.ornek.com
ACME_EMAIL=

# PostgreSQL (yalnızca iç ağda; dışarıya port açılmaz)
POSTGRES_DB=realmarket
POSTGRES_USER=realmarket
POSTGRES_PASSWORD=

# API
AUTH_SECRET=
SEED_ADMIN_EMAIL=admin@ornek.com
SEED_ADMIN_PASSWORD=
# Site ve Unity aynı alan adından sunuluyorsa boş bırakın (aynı köken). Farklı köken(ler):
# CORS_ORIGINS=https://site.ornek.com,https://cdn.ornek.com
CORS_ORIGINS=
OFF_USER_AGENT="RealMarket3D/1.0 (iletisim@ornek.com)"

# API imajı (deploy iş akışı GHCR'ye yayımlar)
API_IMAGE=ghcr.io/zemora35/realmarket-3d-api:latest
