# RealMarket 3D — örnek ortam değişkenleri.
# Bu dosyayı `.env` olarak kopyalayın. `.env` git'e eklenmez.

# --- API ---
API_PORT=3001
API_HOST=127.0.0.1
NODE_ENV=development

# Veritabanı:
#  - DATABASE_URL boş bırakılırsa gömülü PGlite (WASM PostgreSQL) kullanılır,
#    veri PGLITE_DIR klasöründe saklanır. Docker gerekmez.
#  - Gerçek PostgreSQL için (ör. infrastructure/docker/docker-compose.yml):
#    DATABASE_URL=postgres://realmarket:realmarket@localhost:5432/realmarket
DATABASE_URL=
PGLITE_DIR=.data/pglite

# Oturum/admin token imzalama anahtarı. Üretimde uzun rastgele bir değer verin.
AUTH_SECRET=change-me-in-production

# İlk açılışta oluşturulan admin hesabı (yalnızca geliştirme amaçlı).
SEED_ADMIN_EMAIL=admin@realmarket.local
SEED_ADMIN_PASSWORD=change-me-dev-only

# Yüklenen dosyalar için yerel depolama (S3/MinIO adaptörü ileride).
STORAGE_DIR=storage

# Open Food Facts istekleri için tanımlayıcı User-Agent (OFF kuralı gereği zorunlu).
OFF_USER_AGENT="RealMarket3D/0.1 (dev; contact@example.com)"
